{
  "components": {
    "schemas": {
      "AuthStatus": {
        "properties": {
          "mode": {
            "enum": [
              "local",
              "server"
            ],
            "title": "Mode",
            "type": "string"
          },
          "signed_in": {
            "title": "Signed In",
            "type": "boolean"
          }
        },
        "required": [
          "mode",
          "signed_in"
        ],
        "title": "AuthStatus",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MessageView": {
        "properties": {
          "author_kind": {
            "enum": [
              "user",
              "agent",
              "system"
            ],
            "title": "Author Kind",
            "type": "string"
          },
          "author_name": {
            "title": "Author Name",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "from_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From Agent"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "parts": {
            "items": {
              "discriminator": {
                "mapping": {
                  "text": "#/components/schemas/TextPart",
                  "tool_call": "#/components/schemas/ToolCallPart",
                  "tool_result": "#/components/schemas/ToolResultPart"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextPart"
                },
                {
                  "$ref": "#/components/schemas/ToolCallPart"
                },
                {
                  "$ref": "#/components/schemas/ToolResultPart"
                }
              ]
            },
            "title": "Parts",
            "type": "array"
          },
          "status": {
            "enum": [
              "complete",
              "streaming",
              "queued",
              "stopped",
              "interrupted"
            ],
            "title": "Status",
            "type": "string"
          },
          "turn_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turn Id"
          }
        },
        "required": [
          "id",
          "turn_id",
          "author_kind",
          "author_name",
          "from_agent",
          "parts",
          "status",
          "created_at"
        ],
        "title": "MessageView",
        "type": "object"
      },
      "PasswordSignIn": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "PasswordSignIn",
        "type": "object"
      },
      "SendMessage": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "SendMessage",
        "type": "object"
      },
      "SessionView": {
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "busy": {
            "title": "Busy",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_seq": {
            "title": "Last Seq",
            "type": "integer"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageView"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "id",
          "agent",
          "busy",
          "messages",
          "last_seq"
        ],
        "title": "SessionView",
        "type": "object"
      },
      "TextPart": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "text",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "title": "TextPart",
        "type": "object"
      },
      "TokenSignIn": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "TokenSignIn",
        "type": "object"
      },
      "ToolCallPart": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input": {
            "additionalProperties": true,
            "title": "Input",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "const": "tool_call",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "name",
          "input"
        ],
        "title": "ToolCallPart",
        "type": "object"
      },
      "ToolResultPart": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "is_error": {
            "title": "Is Error",
            "type": "boolean"
          },
          "tool_call_id": {
            "title": "Tool Call Id",
            "type": "string"
          },
          "type": {
            "const": "tool_result",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "tool_call_id",
          "content",
          "is_error"
        ],
        "title": "ToolResultPart",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "mlops-agents",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "sign_in_with_password_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordSignIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign In With Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Ends the session in this browser only: sessions are stateless signed cookies.",
        "operationId": "sign_out_api_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Sign Out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/status": {
      "get": {
        "operationId": "auth_status_api_auth_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Auth Status",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/token": {
      "post": {
        "operationId": "sign_in_with_token_api_auth_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenSignIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign In With Token",
        "tags": [
          "auth"
        ]
      }
    },
