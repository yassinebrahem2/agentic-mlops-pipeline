    "/api/projects/{project_id}/agents/{agent}/session/stream": {
      "get": {
        "operationId": "stream_session_api_projects__project_id__agents__agent__session_stream_get",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "title": "Project Id",
              "type": "string"
            }
          },
          {
            "in": "path",
