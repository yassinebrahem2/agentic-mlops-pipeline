ARG DUCKDB_VERSION=2.0.0
ARG DUCKDB_CLI_SHA256_AMD64=c6507206baf7793c6013dbd82368469a45f20dc0e17a6f92f204602f652ed2bc
ARG DUCKDB_CLI_SHA256_ARM64=859e1875d2a9515fbb4bf8871061437a14af82320da68c753f094c4b776348fe

RUN python -m ensurepip --upgrade && \
    python -m pip install --no-cache-dir duckdb==${DUCKDB_VERSION} && \
    python -c "import hashlib, os, platform, shutil, sys, tarfile, urllib.request, zipfile; m = platform.machine().lower(); arch = {'x86_64': 'amd64', 'amd64': 'amd64', 'aarch64': 'arm64', 'arm64': 'arm64'}.get(m); sys.exit(f'Unsupported architecture: {m}') if not arch else None; ver = os.environ['DUCKDB_VERSION']; sha = os.environ['DUCKDB_CLI_SHA256_' + arch.upper()]; asset = f'duckdb-cli-linux-{arch}.tar.gz'; url = f'https://github.com/duckdb/duckdb/releases/download/v{ver}/{asset}'; tmp = f'/tmp/{asset}'; req = urllib.request.Request(url, headers={'User-Agent': 'mlops-agents'}); resp = urllib.request.urlopen(req); data = resp.read(); actual = hashlib.sha256(data).hexdigest(); sys.exit(f'SHA256 mismatch for {asset}: expected {sha}, got {actual}') if actual != sha else None; open(tmp, 'wb').write(data); tar = tarfile.open(tmp, 'r:gz') if asset.endswith(('.tar.gz', '.tgz')) else zipfile.ZipFile(tmp); member_file = tar.extractfile(next(m for m in tar.getmembers() if os.path.basename(m.name) == 'duckdb')) if hasattr(tar, 'extractfile') else None; binary = member_file.read() if member_file else (tar.read(next(n for n in tar.namelist() if os.path.basename(n) == 'duckdb')) if hasattr(tar, 'read') else b''); open('/usr/local/bin/duckdb', 'wb').write(binary); tar.close(); os.chmod('/usr/local/bin/duckdb', 0o755); os.remove(tmp)"
