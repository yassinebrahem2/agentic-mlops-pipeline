ARG DUCKDB_VERSION
ARG DUCKDB_CLI_SHA256_AMD64
ARG DUCKDB_CLI_SHA256_ARM64

RUN python -c "import hashlib, os, platform, sys, tarfile, urllib.request; m = platform.machine().lower(); arch = {'x86_64': 'amd64', 'amd64': 'amd64', 'aarch64': 'arm64', 'arm64': 'arm64'}.get(m); sys.exit(f'Unsupported architecture: {m}') if not arch else None; ver = os.environ['DUCKDB_VERSION']; sha = os.environ['DUCKDB_CLI_SHA256_' + arch.upper()]; asset = f'duckdb-cli-linux-{arch}.tar.gz'; url = f'https://github.com/duckdb/duckdb/releases/download/v{ver}/{asset}'; tmp = f'/tmp/{asset}'; req = urllib.request.Request(url, headers={'User-Agent': 'mlops-agents'}); resp = urllib.request.urlopen(req, timeout=60); data = resp.read(); actual = hashlib.sha256(data).hexdigest(); sys.exit(f'SHA256 mismatch for {asset}: expected {sha}, got {actual}') if actual != sha else None; open(tmp, 'wb').write(data); tar = tarfile.open(tmp, 'r:gz'); member_file = tar.extractfile(next(m for m in tar.getmembers() if os.path.basename(m.name) == 'duckdb')); binary = member_file.read() if member_file else b''; open('/usr/local/bin/duckdb', 'wb').write(binary); tar.close(); os.chmod('/usr/local/bin/duckdb', 0o755); os.remove(tmp)"
